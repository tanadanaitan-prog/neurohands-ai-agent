# Copy to .env for local use. Set real values in Railway Variables for hosting.
# Keep credentials out of Git. Replace the secrets exposed in screenshots.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Separate random 32-byte base64 key for encrypted queued events. Keep stable across deployments.
WEBHOOK_ENCRYPTION_KEY=
SUPABASE_URL=https://darxiaearohhnxiwhcbs.supabase.co
# Server-only sb_secret_ key; the variable name is kept for compatibility.
SUPABASE_SERVICE_KEY=
# Public key for website sign-in. This is a different key from the server secret.
SUPABASE_PUBLISHABLE_KEY=
# Experimental Phase 2 website; keep off during Phase 1 stabilization.
ENABLE_STUDIO=false

GEMINI_API_KEY=
# Set false to use the fallback provider directly while retaining the Gemini key.
# Changing this flag requires an application restart/redeployment.
GEMINI_ENABLED=false
# Value observed in the existing Railway screenshots; availability is unverified.
GEMINI_MODEL=gemini-3.6-flash
FALLBACK_PROVIDER=openrouter
FALLBACK_API_KEY=
FALLBACK_MODEL=
# Keep the :free suffix. Confirm the account's free allowance before live tests.
FALLBACK_MODELS=openai/gpt-oss-120b:free
FALLBACK_BASE_URL=

FOUNDER_LINE_ID=
# Optional founder activation; only FOUNDER_LINE_ID is eligible. Blank disables it.
JARVIS_ACTIVATION_CODE=
# Blank disables the corresponding endpoint.
NEUROHANDS_API_KEY=
CRON_SECRET=

# Set to your HTTPS app URL before issuing upload links.
# Railway's RAILWAY_PUBLIC_DOMAIN is used if PUBLIC_URL is blank.
PUBLIC_URL=
# Railway supplies PORT automatically. For local use:
PORT=3000

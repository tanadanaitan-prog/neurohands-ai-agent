{
  "name": "neurohands-ai-agent",
  "version": "3.10.0",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "check": "node --check src/server.js && node --check src/platform/router.js && node --check src/platform/repository.js && node --check scripts/setup-richmenu.js && node scripts/setup-richmenu.js --check",
    "test": "node --test",
    "richmenu:check": "node scripts/setup-richmenu.js --check",
    "richmenu:setup": "node --env-file-if-exists=.env scripts/setup-richmenu.js",
    "build": "vite build --config web/vite.config.mjs",
    "dev:web": "vite --config web/vite.config.mjs",
    "lab:check": "node scripts/langgraph-lab.mjs check",
    "lab:trace": "node scripts/langgraph-lab.mjs trace",
    "lab:studio": "node scripts/langgraph-lab.mjs studio"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.115.0",
    "express": "4.22.2",
    "mammoth": "1.12.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@langchain/core": "1.2.11",
    "@langchain/langgraph": "1.4.15",
    "@langchain/langgraph-cli": "1.4.6",
    "langsmith": "0.10.4",
    "supabase": "2.116.0",
    "vite": "8.2.2",
    "zod": "4.6.5"
  }
}

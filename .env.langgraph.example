# Local synthetic LangGraph lab only. Copy to .env.langgraph; keep that file private.
# Paste the existing LangSmith "Neurohands Test" key after the equals sign.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=neurohands-local-test
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Optional for a key that covers multiple workspaces.
LANGSMITH_WORKSPACE_ID=
# Keep automatic tracing off; npm run lab:trace sends one fixed synthetic run.
LANGSMITH_TRACING=false
